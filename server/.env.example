# ── Server Configuration ──────────────────────────────────────────
PORT=4006
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────
# CORS allowed origin (e.g., https://your-domain.com)
# Use '*' for development only
ALLOWED_ORIGIN=*

# ── Database (PostgreSQL) ────────────────────────────────────────
# Connection string: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/college_chatbot

# ── Vector Search (Qdrant) ───────────────────────────────────────
# Local or cloud URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key

# ── AI / LLM (OpenRouter) ────────────────────────────────────────
# Required for chat, embeddings, and context extraction
OPENROUTER_API_KEY=your_openrouter_api_key

# Model to use for chat generation.
# Free high-context options:
# - nvidia/nemotron-3.5-lightning:free (1,000,000 tokens context)
# - google/gemma-4-31b-it:free (262,144 tokens context)
# - openrouter/free (200,000 tokens context - auto-routes to best available free model)
# Paid default: openai/gpt-4o-mini (128,000 tokens context)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Number of past conversation turns to retain for context memory
CHAT_HISTORY_LIMIT=20

# ── Search (Tavily) ──────────────────────────────────────────────
# Required for live web fallback search
TAVILY_API_KEY=your_tavily_api_key

# ── Voice / Speech (Eleven Labs) ──────────────────────────────────
# Required for text-to-speech functionality (optional)
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key

# ── Firebase Admin (Optional - for admin dashboard & auth) ───────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
