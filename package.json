{
  "name": "academia-ai",
  "version": "1.0.0",
  "private": true,
  "description": "The Intelligent College Intelligence Engine",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
