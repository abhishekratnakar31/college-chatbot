# ==========================================
# College Chatbot Environment Variables
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=4006
ALLOWED_ORIGIN="*"

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_chatbot"

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="" # Leave empty if running Qdrant locally without auth

# ------------------------------------------
# API Keys (External Services)
# ------------------------------------------
# OpenRouter API Key for LLM and Embeddings
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
CHAT_HISTORY_LIMIT=20

# Tavily API Key for Live Web Search (Optional)
TAVILY_API_KEY="tvly-your-api-key-here"

# Eleven Labs API Key for Voice / Speech (Optional)
ELEVEN_LABS_API_KEY="your-eleven-labs-api-key-here"

# ------------------------------------------
# Frontend (Next.js) Configuration
# ------------------------------------------
# If placing this in the `web` folder, rename to `.env.local`
NEXT_PUBLIC_API_URL="http://127.0.0.1:4006"
